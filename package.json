{
  "name": "dsh-reliability-guards",
  "version": "0.1.0",
  "description": "Reliability guards for small local models in DeepSeek Harness: in-turn correction of false success, invented DOIs, denied capabilities and cut answers; approval before destructive commands; /explain read-only mode.",
  "type": "module",
  "license": "MIT",
  "author": "Mathieu Portmann",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MathieuPortmann/dsh-reliability-guards.git"
  },
  "homepage": "https://github.com/MathieuPortmann/dsh-reliability-guards#readme",
  "bugs": {
    "url": "https://github.com/MathieuPortmann/dsh-reliability-guards/issues"
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "agent",
    "guardrails",
    "reliability",
    "local-llm",
    "ollama"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0",
    "dsh": ">=0.2.0-rc.2 <0.3.0"
  },
  "scripts": {
    "test": "node --test \"tests/*.test.mjs\""
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "lib",
    "cordis.patch.yml",
    "skills",
    "SPEC.md",
    "README.md",
    "LICENSE"
  ],
  "peerDependencies": {
    "@deepseek-ai/dsh-llm": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/dsh-skill": ">=0.2.0-rc.2 <0.3.0",
    "@deepseek-ai/schemastery": ">=3.18.0 <4.0.0",
    "zod": ">=4.0.0 <5.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-skill": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat",
        "@deepseek-ai/dsh-client-locale"
      ]
    },
    "manifestVersion": 1
  }
}
